{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Ai": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite",
    "ThinkingLevel": "LOW",
    "MaxOutputTokens": 1024,
    "AttemptTimeoutSeconds": 20
  },
  "Usage": {
    "DailyTokenLimitPerUser": 150000,
    "MaxActiveSessionsPerUser": 3,
    "Pricing": {
      "gemini-3.5-flash-lite": {
        "InputPerMillionUsd": 0.3,
        "OutputPerMillionUsd": 2.5
      },
      "gemini-4-hydrogen": {
        "InputPerMillionUsd": 1.5,
        "OutputPerMillionUsd": 7.5
      },
      "gemini-3.6-flash": {
        "InputPerMillionUsd": 0.75,
        "OutputPerMillionUsd": 3.75
      }
    }
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "AiPermitsPerMinute": 20
  },
  "Jwt": {
    "Issuer": "speakmate-api",
    "Audience": "speakmate-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}
